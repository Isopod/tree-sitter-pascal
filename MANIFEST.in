include LICENSE.md
include README.md
include pyproject.toml
include setup.py
include src/parser.c
include src/grammar.json
include src/node-types.json
recursive-include src/tree_sitter *.h
recursive-include bindings/python/tree_sitter_pascal *.c *.py *.pyi py.typed
